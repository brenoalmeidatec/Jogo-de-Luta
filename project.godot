; Arquivo de configuração do projeto Godot 4.
; Tela base 304x224 (resolução de arcade, proporção do KOF), ampliada 4x na janela.
; Abra esta pasta na Godot 4.3 (ou mais nova) e clique em "Importar".

config_version=5

[application]

config/name="Jogo de Luta"
config/description="Jogo de luta 2D original, estilo arcade."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=304
window/size/viewport_height=224
window/size/window_width_override=1216
window/size/window_height_override=896
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

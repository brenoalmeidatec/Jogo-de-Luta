[Quotes]
victory1 = "F-f-foi de letra, filho da puta."
victory2 = "T-t-tá achando que é pe-pelada de domingo, é, ca-caralho?"
victory3 = "V-v-vai lá contar pra tua mãe que tu a-a-apanhou do gago."
victory4 = "Eu chu-chupo... chu-chu-CHUTO melhor que tu, porra!"
victory5 = "T-tu ficou pa-parado igual cone. Ma-mas cone pelo menos fica de pé."
victory6 = "D-d-demorei pra falar, mas tu de-de-demorou mais pra levantar."
victory7 = "Mi-minhas bolas... MINHA BOLA tá sempre no pé, pa-pa-parceiro."


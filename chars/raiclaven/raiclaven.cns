; >>> aura_silhueta.py estado: o helper da aura de silhueta
[Statedef 9610]
type = A
movetype = I
physics = N
anim = 30000
ctrl = 0
velset = 0, 0
sprpriority = -3

[State 9610, cola no corpo]
type = BindToParent
trigger1 = 1
pos = 0, 0
facing = 1
time = 1
ignorehitpause = 1

[State 9610, mesmo quadro do corpo]
type = ChangeAnim
trigger1 = SelfAnimExist(30000 + parent,Anim) && parent,AnimElemNo(0) > 0
value = 30000 + parent,Anim
elem = (parent,AnimElemNo(0) - 1) * 6 + 1 + (floor(GameTime / 2) % 6)
ignorehitpause = 1

[State 9610, brilho]
type = Trans
trigger1 = 1
trans = add
alpha = ifelse(SelfAnimExist(30000 + parent,Anim) && parent,AnimElemNo(0) > 0, floor(170 * floor(255 * min(1, max(0, root,map(au_raiclaven_e)))) / 255), 0), 255
ignorehitpause = 1

[State 9610, sem sombra]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 9610, chama]
type = Explod
trigger1 = SelfAnimExist(30000 + parent,Anim) && parent,AnimElemNo(0) > 0 && root,map(au_raiclaven_e) > 0.02
anim = 40000 + parent,Anim
id = 9611
animelem = (parent,AnimElemNo(0) - 1) * 6 + 1 + (floor(GameTime / 2) % 6)
animfreeze = 1
postype = p1
pos = 0, 0
facing = 1
bindtime = 1
removetime = 1
sprpriority = -4
ownpal = 1
removeongethit = 0
supermovetime = -1
pausemovetime = -1
trans = addalpha
alpha = floor(255 * min(1, max(0, root,map(au_raiclaven_e)))), 255 - floor(255 * min(1, max(0, root,map(au_raiclaven_e))))
scale = 0.666666, 0.666666 * (1 + 0.04 * max(-3, min(6, root,map(au_sil_y))))
xshear = -0.02 * max(-5, min(5, root,map(au_sil_x)))
ignorehitpause = 1

; <<< aura_silhueta.py

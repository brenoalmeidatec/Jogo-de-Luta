[State -2, Forma fica: marca que despertou]
type = VarSet
trigger1 = var(20) > 0
var(58) = 1

[State -2, Forma fica: volta no round seguinte]
type = VarSet
trigger1 = var(58) = 1 && var(20) <= 0
var(20) = 600

[State -2, Forma fica: marca a musica]
type = VarSet
trigger1 = var(51) = 1
var(59) = 1

[State -2, Forma fica: musica volta no round seguinte]
type = PlayBGM
trigger1 = var(59) = 1 && var(51) = 0 && roundstate >= 1
bgm = "despertar.ogg"
volume = 100
loop = 1
loopstart = 0

[State -2, Forma fica: musica marcada no round seguinte]
type = VarSet
trigger1 = var(59) = 1 && var(51) = 0 && roundstate >= 1
var(51) = 1

[State -2, Musica do cenario comeca a baixar]
type = VarSet
trigger1 = roundstate = 2 && var(51) = 0 && (var(20) > 0 || stateno = 2000)
var(52) = 0

[State -2, Marca fade da musica]
type = VarSet
trigger1 = roundstate = 2 && var(51) = 0 && (var(20) > 0 || stateno = 2000)
var(51) = 2

[State -2, Musica do cenario baixando]
type = ModifyBGM
trigger1 = var(51) = 2 && var(52) < 45
volume = 100 - (var(52) + 1) * 100 / 45

[State -2, Conta fade da musica]
type = VarAdd
trigger1 = var(51) = 2 && var(52) < 45
var(52) = 1

[State -2, Musica do Despertar entra]
type = PlayBGM
trigger1 = var(51) = 2 && var(52) >= 45
bgm = "despertar.ogg"
volume = 100
loop = 1
loopstart = 0

[State -2, Marca musica do Despertar]
type = VarSet
trigger1 = var(51) = 2 && var(52) >= 45
var(51) = 1

[State -2, Musica do cenario volta]
type = PlayBGM
trigger1 = var(51) != 0 && var(20) <= 0 && stateno != 2000
trigger1 = NumEnemy = 0 || enemy,var(51) != 1
source = "stagedef."

[State -2, Desmarca musica do Despertar]
type = VarSet
trigger1 = var(51) != 0 && var(20) <= 0 && stateno != 2000
var(51) = 0

[State -2, Ressaca começa]
type = VarSet
trigger1 = var(20) = 1
var(21) = 60

[State -2, Ressaca conta]
type = VarAdd
trigger1 = var(21) > 0
var(21) = -1

[State -2, Paredão some no começo do round]
type = RemoveExplod
trigger1 = roundstate = 2
trigger1 = NumExplod(9254)
id = 9254

[State -2, Chapado: tempo]
type = VarSet
trigger1 = var(20) > 0 && Time = 0 && (stateno = [3410, 3435]) && statetype != A
var(40) = Random % 3

[State -2, Chapado: alcance]
type = PosAdd
trigger1 = var(20) > 0 && Time = 0 && (stateno = [3410, 3435]) && statetype != A
x = Random % 6

[State -2, Zera o corte na intro]
type = VarSet
trigger1 = roundstate < 2
var(42) = 0

[State -2, Corte abre]
type = VarSet
trigger1 = var(20) > 0 && MoveHit = 1 && ((stateno = [3410, 3413]) || stateno = 3430 || stateno = 3431 || stateno = 3436)
var(42) = 90

[State -2, Corte sangra]
type = LifeAdd
trigger1 = var(42) > 0 && (var(42) % 15) = 0 && NumEnemy > 0
trigger1 = roundstate = 2
value = -3
kill = 0
redirectid = enemynear,id

[State -2, Corte fecha]
type = VarAdd
trigger1 = var(42) > 0
var(42) = -1

[State -2, Fumaça na saída do Despertar]
type = Explod
trigger1 = var(20) = 12 && NumExplod(9215) = 0
anim = 9253
id = 9215
postype = p1
pos = 0, 0
removetime = 20
sprpriority = 4
ownpal = 1
scale = 1, 1
ignorehitpause = 1
supermovetime = -1

[State -2, Bônus de dano]
type = AttackMulSet
trigger1 = 1
value = ifelse(var(20) > 0 && stateno != 3100, 1.45, 1)

[State -2, Vira endiabrado]
type = RemapSprite
trigger1 = (var(20) > 0 || stateno = 3100) && var(37) = 0
preset = "despertado"

[State -2, Endiabrado ligado]
type = VarSet
trigger1 = var(20) > 0 || stateno = 3100
var(37) = 1

[State -2, Volta ao normal]
type = RemapSprite
trigger1 = var(20) <= 0 && stateno != 3100 && var(37) = 1
trigger2 = roundstate < 2
reset = 1

[State -2, Endiabrado desligado]
type = VarSet
trigger1 = var(20) <= 0 && stateno != 3100
var(37) = 0

[State -2, Ressaca anda devagar]
type = PosAdd
trigger1 = stateno = 20
trigger1 = var(21) > 0
x = -vel x * .2

[State -2, Round falado]
type = VarSet
trigger1 = roundstate = 2
var(31) = 1

[State -2, Primeiro golpe falado]

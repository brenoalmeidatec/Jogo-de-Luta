[Statedef -2]

; Musica do Despertar (Breno, issue #33), posta pelo cena_transformacao.py: a do cenario baixa ate sumir, entra a do lutador.
[State -2, Zera musica na intro]
type = VarSet
trigger1 = roundstate < 2
var(51) = 0

[State -2, Musica do cenario comeca a baixar]
type = VarSet
trigger1 = roundstate = 2 && var(51) = 0 && (var(20) > 0 || stateno = 2000)
var(52) = 0

[State -2, Marca fade da musica]
type = VarSet
trigger1 = roundstate = 2 && var(51) = 0 && (var(20) > 0 || stateno = 2000)
var(51) = 2

[State -2, Musica do cenario baixando]
type = ModifyBGM
trigger1 = var(51) = 2 && var(52) < 45
volume = 100 - (var(52) + 1) * 100 / 45

[State -2, Conta fade da musica]
type = VarAdd
trigger1 = var(51) = 2 && var(52) < 45
var(52) = 1

[State -2, Musica do Despertar entra]
type = PlayBGM
trigger1 = var(51) = 2 && var(52) >= 45
bgm = "despertar.ogg"
volume = 100
loop = 1
loopstart = 4171115

[State -2, Marca musica do Despertar]
type = VarSet
trigger1 = var(51) = 2 && var(52) >= 45
var(51) = 1

[State -2, Musica do cenario volta]
type = PlayBGM
trigger1 = var(51) != 0 && var(20) <= 0 && stateno != 2000
trigger1 = NumEnemy = 0 || enemy,var(51) != 1
source = "stagedef."

[State -2, Desmarca musica do Despertar]
type = VarSet
trigger1 = var(51) != 0 && var(20) <= 0 && stateno != 2000
var(51) = 0

[State -2, Conta Diabo Loiro]
type = VarAdd
trigger1 = var(20) > 0
var(20) = -1

[State -2, Vira o Diabo]
type = RemapSprite
trigger1 = var(20) > 0 && var(37) = 0
preset = "despertado"

[State -2, Diabo ligado]
type = VarSet
trigger1 = var(20) > 0
var(37) = 1

[State -2, Volta ao normal]
type = RemapSprite
trigger1 = var(20) <= 0 && var(37) = 1
trigger2 = roundstate < 2
reset = 1

[State -2, Diabo desligado]
type = VarSet
trigger1 = var(20) <= 0
var(37) = 0

[State -2, Peso do Diabo]
type = AttackMulSet
trigger1 = 1
value = ifelse(var(20) > 0, 1.25, 1)

[State -2, Zera fracos]
type = VarSet
trigger1 = ctrl
var(5) = 0

; corrente de 3 golpes: var(10) conta os acertos de verdade (defendido não conta); var(11) trava a contagem para o
; mesmo acerto não somar duas vezes durante a pausa do contato. O finalizador exige var(10) >= 3 (4 na corrente x).
[State -2, Zera corrente]
type = VarSet
trigger1 = ctrl
var(10) = 0

[State -2, Conta acerto da corrente]
type = VarAdd
trigger1 = MoveHit
trigger1 = var(11) = 0
trigger1 = stateno = [200,349]
var(10) = 1

[State -2, Trava contagem]
type = VarSet
trigger1 = MoveHit
trigger1 = var(11) = 0
var(11) = 1

[State -2, Libera contagem]
type = VarSet
trigger1 = !MoveHit
var(11) = 0

; Rastro de velocidade da corrida (ficha): 2 ticks de rastro, renovado a cada 8 ticks; cortado ao sair da corrida
; (menos para a voadora e os supers, que têm o rastro deles). O -2 roda antes da troca de estado do tick: o 1º tick
; que ele vê do estado novo é o Time = 1 (com Time % 8 = 0 o rastro só nascia no 8º tick da corrida).
[State -2, Rastro da corrida]
type = AfterImage
trigger1 = stateno = 100
trigger1 = (Time % 8) = 1
time = 8
length = 3
timegap = 1
framegap = 1
trans = add
palcolor = 0
palbright = 40,40,40
paladd = 0,0,0
palmul = .6,.6,.6

[State -2, Fim do rastro da corrida]
type = AfterImageTime
trigger1 = prevstateno = 100
trigger1 = Time <= 1
trigger1 = stateno != 100
trigger1 = stateno != [1500,1501]
trigger1 = stateno != [3000,3299]
time = 1

[State -2, Passo para trás invencível]
type = NotHitBy
trigger1 = stateno = 105
trigger1 = Time < 6
value = SCA
time = 1

; Derrota: toca uma sirene (áudio pendente), ele levanta num pulo e foge correndo para fora da tela. Por nocaute o
; estado continua o 5150 do motor (a lógica do KO não muda): só a animação e a posição mudam. Os desenhos 4 a 7 da
; folha derrota_sirene foram desenhados olhando para TRÁS (para a esquerda da folha, de costas para o oponente): ele
; corre de frente para a saída. Por isso não há Turn nem flip no .air.
[State -2, Sirene: levanta]
type = ChangeAnim
trigger1 = !alive && stateno = 5150 && Time = 40
value = 171

[State -2, Sirene: foge]
type = PosAdd
trigger1 = anim = 171 && AnimElemNo(0) >= 6
trigger2 = stateno = 170 && AnimElemNo(0) >= 3
x = -5

; A tela só solta ele quando começa a correr. Solta desde o começo da animação, a câmera largava o caído e ia para
; o vencedor: ele saía do quadro ainda deitado e ninguém via o pulo nem a corrida (visto no filme).
[State -2, Sirene: sai da tela]
type = ScreenBound
trigger1 = anim = 171 && AnimElemNo(0) >= 6
trigger2 = stateno = 170 && AnimElemNo(0) >= 3
value = 0
movecamera = 0,0


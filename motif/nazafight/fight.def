; Relogio: caixinha escura de quinas cortadas com 2 digitos (fonte 5, grade 2x); abaixo de 10 s, fonte 2 em vermelho,
; cujos glifos ja trazem o zero na frente (o motor escreve 8, a tela mostra 08).
[Time]
pos = 640,12
bg.spr = 40,0
bg.layerno = 2
counter.font = 2,0,0
counter.layerno = 2
counter.offset = 0,45
counter10.font = 5,0,0
counter10.layerno = 2
counter10.offset = 0,45
framespercount = 60

[Combo]
pos = 40,300
start.x = -320
counter.font = 1,0,1
counter.layerno = 2
counter.shake = 1
text.font = 3,0,1
text.layerno = 2
text.text = "ACERTOS"
text.offset = 12,0
displaytime = 90

[Round]
pos = 640,300
match.wins = 2
match.maxdrawgames = 1
start.waittime = 30
ctrl.time = 30
; Fim de round mais rapido (estilo KOF). Padrao do IKEMEN: camera lenta 60 ticks a 1/4, espera 45 + 45 ticks e
; round acabando 300 ticks depois do KO: ~3 s do KO ate a pose de vitoria.
slow.time = 24
slow.fadetime = 16
slow.speed = 0.5
over.hittime = 10
over.waittime = 15
over.wintime = 10
over.time = 220
round.default.font = 4,0,0
round.default.text = "ROUND %i"
round.default.displaytime = 60
round1.anim = 601
round1.displaytime = 60
round2.anim = 602
round2.displaytime = 60
round3.anim = 603
round3.displaytime = 60
round4.anim = 604
round4.displaytime = 60
round5.anim = 605
round5.displaytime = 60
fight.anim = 610
fight.displaytime = 45
ko.anim = 620
dko.font = 4,0,0
dko.text = "DUPLO K.O."
to.font = 4,0,0
to.text = "TEMPO!"
win.font = 4,0,0
win.text = "%s VENCEU"
draw.font = 4,0,0
draw.text = "EMPATE"


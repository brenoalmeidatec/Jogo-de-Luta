; Nazafights - gerado por ferramentas/gerar_layout.py (nao edite a mao: rode o gerador).
; Arte 100% desenhada por codigo em pixel art (grade logica ampliada 4x), paleta de Nazare (BA).

[Info]
name = Nazafights
author = Nazafights
ikemenversion = 1.0
localcoord = 1280,720

[Files]
sff = fight.sff
snd = fight.snd               ; data/fight.snd
font1 = fonts/naza_num.def
font2 = fonts/naza_relogio_alerta.def
font3 = fonts/naza_tab.def
font4 = fonts/naza_menu.def
font5 = fonts/naza_relogio.def
fightfx.sff = fightfx.sff     ; data/
fightfx.air = fightfx.air
common.snd = common.snd

[FightFx]
scale = 4

; Vida: prancha de saveiro com alca de moringa. A vida fica presa na ponta de fora (junto do retrato) e o dano
; abre junto do relogio: o motor prende o enchimento no 1o valor de range.x. folha > 50%, dende 26-50%, taua <= 25%.
[Lifebar]
mid.delay = 30
p1.pos = 144,24
p1.bg0.spr = 10,0
p1.mid.spr = 14,0
p1.mid.offset = 16,8
p1.front.spr = 13,0
p1.front.offset = 16,8
p1.front26.spr = 12,0
p1.front26.offset = 16,8
p1.front51.spr = 11,0
p1.front51.offset = 16,8
p1.range.x = 16,399
p2.pos = 720,24
p2.bg0.spr = 10,1
p2.mid.spr = 14,1
p2.mid.offset = 16,8
p2.front.spr = 13,1
p2.front.offset = 16,8
p2.front26.spr = 12,1
p2.front26.offset = 16,8
p2.front51.spr = 11,1
p2.front51.offset = 16,8
p2.range.x = 399,16

[Simul Lifebar]
[Simul_3P Lifebar]
[Simul_4P Lifebar]
[Turns Lifebar]
[Tag Lifebar]


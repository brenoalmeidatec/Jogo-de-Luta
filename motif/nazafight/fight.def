; Nazafights - gerado por ferramentas/gerar_layout.py (nao edite a mao: rode o gerador).
; Arte 100% desenhada por codigo em pixel art (grade logica ampliada 4x), paleta de Nazare (BA).

[Info]
name = Nazafights
author = Nazafights
ikemenversion = 1.0
localcoord = 1280,720

[Files]
sff = fight.sff
snd = fight.snd               ; data/fight.snd
font1 = fonts/naza_num.def
font2 = fonts/naza_relogio2_alerta.def
font3 = fonts/naza_hud.def
font4 = fonts/naza_menu.def
font5 = fonts/naza_relogio2.def
font6 = fonts/naza_hud_nome.def ; naza_hud com acento (PENGARÓ), so nos nomes
fightfx.sff = fightfx.sff     ; data/
fightfx.air = fightfx.air
common.snd = common.snd

[FightFx]
scale = 4

; Vida (estilo novo, issue #39): trilho fino inclinado. A vida fica presa na ponta de fora (junto do retrato) e o dano
; abre junto do relogio: o motor prende o enchimento no 1o valor de range.x. Ouro > 50%, laranja 26-50%, vermelho <= 25%;
; o dano que ainda vai cair fica em branco.
[Lifebar]
mid.delay = 30
p1.pos = 128,18
p1.bg0.spr = 10,0
p1.bg0.layerno = 2
p1.mid.spr = 14,0
p1.mid.layerno = 2
p1.mid.offset = 6,4
p1.front.spr = 13,0
p1.front.layerno = 2
p1.front.offset = 6,4
p1.front26.spr = 12,0
p1.front26.layerno = 2
p1.front26.offset = 6,4
p1.front51.spr = 11,0
p1.front51.layerno = 2
p1.front51.offset = 6,4
p1.range.x = 6,461
p2.pos = 684,18
p2.bg0.spr = 10,1
p2.bg0.layerno = 2
p2.mid.spr = 14,1
p2.mid.layerno = 2
p2.mid.offset = 6,4
p2.front.spr = 13,1
p2.front.layerno = 2
p2.front.offset = 6,4
p2.front26.spr = 12,1
p2.front26.layerno = 2
p2.front26.offset = 6,4
p2.front51.spr = 11,1
p2.front51.layerno = 2
p2.front51.offset = 6,4
p2.range.x = 461,6

[Simul Lifebar]
[Simul_3P Lifebar]
[Simul_4P Lifebar]
[Turns Lifebar]
[Tag Lifebar]


; Retrato: fundo liso de rio atras, 9000,0 do lutador (25x25, escala inteira 4), anel de barro por cima.
; A moldura encosta na alca da ponta de fora do trilho.
[Face]
p1.pos = 4,4
p1.bg.spr = 30,0
p1.face.spr = 9000,0
p1.face.offset = 8,8
p1.ko.spr = 32,0
p1.top.spr = 31,0
p2.pos = 1160,4
p2.bg.spr = 30,1
p2.face.spr = 9000,0
p2.face.offset = 108,8
p2.face.facing = -1
p2.ko.spr = 32,1
p2.top.spr = 31,1
